rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /shares/{shareId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      // Owners can always read; anyone signed in with the code can read
      // only while the share is active AND not past its expiry.
      allow read: if request.auth != null
        && (
          resource.data.ownerId == request.auth.uid
          || (resource.data.active == true
              && resource.data.expiresAt > request.time.toMillis())
        );

      // Owners can update, but cannot hand the share to someone else.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
